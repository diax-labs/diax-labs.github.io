{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "app-handoff-flow",
  "type": "registry:block",
  "title": "Native App Handoff",
  "description": "A labeled automatic decision flow composed beside a realistic mobile handoff sheet built from ordinary React DOM.",
  "dependencies": ["@diax/react", "@diax/ui-react", "lucide-react"],
  "files": [
    {
      "path": "components/diagrams/app-handoff-flow/app-handoff-flow.tsx",
      "type": "registry:component",
      "content": "\"use client\";\n\nimport { FlowDiagram } from \"@diax/react\";\nimport { DiagramFrame, NodeCard } from \"@diax/ui-react/presentation\";\nimport { ArrowUpRight, Check, Monitor, Smartphone, X } from \"lucide-react\";\n\nconst nodes = [\n  {\n    id: \"entry\",\n    content: (\n      <FlowStep\n        eyebrow=\"Entry\"\n        title=\"Article opened\"\n        description=\"A web page can offer a native continuation without replacing its content.\"\n        tone=\"info\"\n      />\n    ),\n  },\n  {\n    id: \"mobile\",\n    content: (\n      <FlowStep\n        eyebrow=\"Decision 01\"\n        title=\"Mobile browser?\"\n        description=\"Use a capability signal, not a screen-size guess.\"\n        tone=\"accent\"\n      />\n    ),\n  },\n  {\n    id: \"inside-app\",\n    content: (\n      <FlowStep\n        eyebrow=\"Decision 02\"\n        title=\"Already in the native app?\"\n        description=\"Avoid presenting a handoff action that cannot add value.\"\n        tone=\"accent\"\n      />\n    ),\n  },\n  {\n    id: \"prepare\",\n    content: (\n      <FlowStep\n        eyebrow=\"Transform\"\n        title=\"Build a deterministic link\"\n        description=\"Combine a versioned schema with the current canonical URL.\"\n        tone=\"warning\"\n      />\n    ),\n  },\n  {\n    id: \"sheet\",\n    content: (\n      <FlowStep\n        eyebrow=\"Presentation\"\n        title=\"Show the handoff sheet\"\n        description=\"Keep the web page readable until the user explicitly continues.\"\n        tone=\"success\"\n      />\n    ),\n  },\n  {\n    id: \"stay-web\",\n    content: (\n      <FlowStep\n        eyebrow=\"Terminal\"\n        title=\"Keep the web experience\"\n        description=\"No dead-end prompt on desktop.\"\n        tone=\"neutral\"\n      />\n    ),\n  },\n  {\n    id: \"stay-native\",\n    content: (\n      <FlowStep\n        eyebrow=\"Terminal\"\n        title=\"Continue in the current app\"\n        description=\"The native context already owns the journey.\"\n        tone=\"neutral\"\n      />\n    ),\n  },\n];\n\nconst relations = [\n  \"entry->mobile\",\n  \"mobile->|No|stay-web\",\n  \"mobile->|Yes|inside-app\",\n  \"inside-app->|Yes|stay-native\",\n  \"inside-app->|No|prepare\",\n  \"prepare->sheet\",\n];\n\nexport default function AppHandoffFlow() {\n  return (\n    <DiagramFrame\n      data-showcase-corpus=\"app-handoff-flow\"\n      eyebrow=\"Product decision flow · Automatic layout\"\n      title=\"Native app handoff\"\n      description=\"Let DiaX arrange the decision topology, then compose the result with a real application surface.\"\n      icon={<Smartphone aria-hidden=\"true\" />}\n      caption=\"The flow remains deterministic and accessible. The sheet is ordinary DOM that product teams can restyle or replace.\"\n      className=\"w-full max-w-[1120px] [--diax-frame-bg:#eef2f4] [--diax-frame-radius:3px] [--diax-frame-shadow:none] [--diax-node-bg:#fff] [--diax-node-border:#c9d2d8] [--diax-node-shadow:none] [--diax-node-text:#17212a] [--diax-ui-radius:3px]\"\n    >\n      <div className=\"grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_300px]\">\n        <section\n          className=\"min-w-0 border border-slate-300 bg-[#f7f9fa] p-3\"\n          aria-label=\"Native app handoff decisions\"\n        >\n          <FlowDiagram\n            nodes={nodes}\n            relations={relations}\n            direction=\"vertical\"\n            density=\"compact\"\n            centered\n            stagger\n          />\n        </section>\n\n        <aside\n          className=\"border border-slate-300 bg-white p-3\"\n          aria-label=\"Rendered mobile handoff sheet\"\n        >\n          <div className=\"flex items-center justify-between border-b border-slate-200 pb-3\">\n            <span className=\"font-mono text-[9px] font-bold uppercase tracking-[0.1em] text-slate-500\">\n              Live DOM mock\n            </span>\n            <span className=\"font-mono text-[9px] text-slate-400\">390 × 844</span>\n          </div>\n          <div className=\"mx-auto mt-4 max-w-[250px] border-[5px] border-slate-900 bg-slate-100 p-1.5 [border-radius:22px]\">\n            <div className=\"relative min-h-[430px] overflow-hidden bg-[#e8edf0] [border-radius:14px]\">\n              <div className=\"flex h-7 items-center justify-between bg-white px-3 font-mono text-[8px] text-slate-500\">\n                <span>9:41</span>\n                <span>5G · 84%</span>\n              </div>\n              <div className=\"p-3\">\n                <div className=\"h-2 w-16 bg-slate-300\" />\n                <div className=\"mt-3 h-4 w-4/5 bg-slate-700\" />\n                <div className=\"mt-2 h-2 w-full bg-slate-300\" />\n                <div className=\"mt-1 h-2 w-3/4 bg-slate-300\" />\n                <div className=\"mt-5 aspect-[4/3] border border-slate-300 bg-slate-200\" />\n              </div>\n              <div className=\"absolute inset-0 bg-slate-950/35\" />\n              <section\n                data-app-handoff-sheet\n                className=\"absolute inset-x-0 bottom-0 border-t-[3px] border-[#e8613c] bg-white p-4 text-slate-900\"\n                aria-label=\"Open in native app prompt\"\n              >\n                <div className=\"flex items-start justify-between gap-4\">\n                  <div>\n                    <p className=\"m-0 font-mono text-[8px] font-bold uppercase tracking-[0.1em] text-[#e8613c]\">\n                      Continue the story\n                    </p>\n                    <h2 className=\"m-0 mt-1 text-sm font-semibold\">Open in the native app</h2>\n                  </div>\n                  <X aria-hidden=\"true\" className=\"size-4 text-slate-400\" />\n                </div>\n                <p className=\"m-0 mt-2 text-[10px] leading-relaxed text-slate-500\">\n                  Resume at the same article with saved progress and comments.\n                </p>\n                <div className=\"mt-4 flex items-center justify-between gap-3 border-t border-slate-200 pt-3\">\n                  <span className=\"flex items-center gap-1 text-[9px] text-slate-500\">\n                    <Check aria-hidden=\"true\" className=\"size-3 text-emerald-600\" /> Same\n                    destination\n                  </span>\n                  <span className=\"inline-flex items-center gap-1 bg-[#e8613c] px-3 py-2 text-[10px] font-bold text-white\">\n                    Open App <ArrowUpRight aria-hidden=\"true\" className=\"size-3\" />\n                  </span>\n                </div>\n              </section>\n            </div>\n          </div>\n          <dl className=\"m-0 mt-4 grid grid-cols-2 border-y border-slate-300 text-center\">\n            <MockMetric label=\"Branch labels\" value=\"4\" />\n            <MockMetric label=\"Canvas dependency\" value=\"0\" />\n          </dl>\n        </aside>\n      </div>\n    </DiagramFrame>\n  );\n}\n\nfunction FlowStep({\n  eyebrow,\n  title,\n  description,\n  tone,\n}: {\n  eyebrow: string;\n  title: string;\n  description: string;\n  tone: \"neutral\" | \"accent\" | \"info\" | \"success\" | \"warning\";\n}) {\n  return (\n    <NodeCard\n      title={title}\n      eyebrow={eyebrow}\n      description={description}\n      tone={tone}\n      size=\"compact\"\n      icon={tone === \"neutral\" ? <Monitor aria-hidden=\"true\" /> : undefined}\n      className=\"max-w-[190px]\"\n    />\n  );\n}\n\nfunction MockMetric({ label, value }: { label: string; value: string }) {\n  return (\n    <div className=\"border-l border-slate-300 px-2 py-2 first:border-l-0\">\n      <dt className=\"text-[7px] font-semibold uppercase tracking-[0.08em] text-slate-500\">\n        {label}\n      </dt>\n      <dd className=\"m-0 mt-1 font-mono text-base font-bold text-slate-900\">{value}</dd>\n    </div>\n  );\n}\n"
    }
  ]
}
